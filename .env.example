# Credenciales del proyecto Firebase (Configuracion del proyecto > Tus apps > SDK de Firebase).
# Copiar este archivo a ".env" y completar con los valores reales.
# Nunca subir el archivo ".env" al repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VITE_FIREBASE_STORAGE_BUCKET= (Storage postergado: requiere plan Blaze)
